{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maplefukku/sasaru/schema/playbook.schema.json",
  "title": "sasaru playbook frontmatter",
  "description": "YAML frontmatter of one playbook file. One file is one short-video format. format, hook, beats, captions, camera, and audio describe the cut this recipe makes on its default route. source.reference describes what the reference showed. Numbers describe the form, never the source work: no caption wording, no audio, no frames, no creator identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "status",
    "summary",
    "tags",
    "fitsContent",
    "source",
    "format",
    "hook",
    "beats",
    "captions",
    "camera",
    "audio",
    "routes",
    "fonts",
    "rights",
    "evidence"
  ],
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "beatId": { "type": "string", "pattern": "^b[0-9]+$" },
    "at": {
      "description": "A time keyed to a beat, so it scales with the cut. offsetSec is seconds after the beat's tIn on the reference timeline.",
      "type": "object",
      "additionalProperties": false,
      "required": ["beat", "offsetSec"],
      "properties": {
        "beat": { "$ref": "#/$defs/beatId" },
        "offsetSec": { "type": "number", "minimum": 0 }
      }
    },
    "captionLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "beats",
        "unit",
        "writingMode",
        "font",
        "capHeightRatio",
        "emphasis",
        "color",
        "stroke",
        "shadow",
        "plate",
        "position",
        "linesMax",
        "charsPerCard",
        "motionIn",
        "motionOut",
        "show",
        "leadSec",
        "hide",
        "minHoldSec",
        "lastCard"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^c[0-9]+$" },
        "role": { "enum": ["headline", "subtitle", "label", "counter"] },
        "beats": {
          "description": "Beat ids this layer appears in. An empty array means every beat.",
          "type": "array",
          "items": { "$ref": "#/$defs/beatId" },
          "uniqueItems": true
        },
        "unit": { "enum": ["word", "phrase", "line", "card"] },
        "writingMode": { "enum": ["horizontal", "vertical"] },
        "font": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "weight"],
          "properties": {
            "class": {
              "enum": ["extra-bold-gothic", "bold-gothic", "thin-sans", "rounded", "mincho", "handwritten", "mono", "other"]
            },
            "weight": { "type": "integer", "minimum": 100, "maximum": 1000 }
          }
        },
        "capHeightRatio": {
          "description": "Height of one line's white core divided by frame height. null when not measured.",
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "emphasis": {
          "description": "How emphasized words differ inside this layer. null when the layer has no emphasis.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["scale", "color"],
          "properties": {
            "scale": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "color": { "oneOf": [{ "$ref": "#/$defs/hex" }, { "type": "null" }] }
          }
        },
        "color": { "$ref": "#/$defs/hex" },
        "stroke": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["color", "px1080"],
          "properties": {
            "color": { "$ref": "#/$defs/hex" },
            "px1080": { "description": "Stroke width in px at 1080 px frame width.", "type": "number", "minimum": 0 }
          }
        },
        "shadow": { "type": "boolean" },
        "plate": { "enum": ["none", "box", "pill"] },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cx", "cy", "align"],
          "properties": {
            "cx": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "cy": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "align": { "enum": ["left", "center", "right"] }
          }
        },
        "linesMax": { "type": "integer", "minimum": 1 },
        "charsPerCard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        },
        "motionIn": { "enum": ["cut", "pop", "fade", "slide-up", "typewriter", "word-by-word", "scale-in", "other"] },
        "motionOut": { "enum": ["cut", "fade", "slide", "other"] },
        "show": { "enum": ["onset", "before-onset", "beat-start"] },
        "leadSec": { "description": "Seconds a card appears before its onset when show is before-onset.", "type": ["number", "null"], "minimum": 0 },
        "hide": { "enum": ["next-card", "phrase-end", "beat-end"] },
        "minHoldSec": { "description": "Shortest time a card stays on screen. null when not measured.", "type": ["number", "null"], "minimum": 0 },
        "lastCard": { "enum": ["hold-to-end", "phrase-end"] }
      }
    }
  },
  "properties": {
    "schema": { "const": "sasaru-playbook/1" },
    "id": {
      "description": "Kebab-case. Equals the file name without .md.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "status": {
      "description": "draft: inferred only. measured: numbers came from ingest. produced: at least one cut was made with this playbook and passed the gate.",
      "enum": ["draft", "measured", "produced"]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "uniqueItems": true },
    "fitsContent": {
      "description": "Kinds of the maker's own content this format can carry, for the pick step.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "platform", "rightsTier", "measuredFiles"],
      "properties": {
        "kind": { "enum": ["ingested", "hand-written"] },
        "platform": { "enum": ["instagram-reels", "tiktok", "youtube-shorts", "other", "none"] },
        "rightsTier": {
          "description": "A own work, B licensed, C third-party public (analysis only), none for hand-written.",
          "enum": ["A", "B", "C", "none"]
        },
        "ingestedAt": { "type": "string", "format": "date" },
        "measuredFiles": { "type": "integer", "minimum": 0 },
        "reference": {
          "description": "What the reference showed, when it differs from the recipe. A talking-to-camera reference is recorded here, not in format.",
          "type": "object",
          "additionalProperties": false,
          "required": ["onCamera", "speech", "hardCuts"],
          "properties": {
            "onCamera": { "enum": ["none", "hands", "body-no-face", "face"] },
            "speech": { "enum": ["none", "voiceover", "on-camera"] },
            "hardCuts": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      },
      "if": { "properties": { "kind": { "const": "ingested" } } },
      "then": {
        "required": ["ingestedAt", "reference"],
        "properties": { "measuredFiles": { "minimum": 1 }, "rightsTier": { "enum": ["A", "B", "C"] } }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect", "fps", "durationSec", "onCamera", "speech"],
      "properties": {
        "aspect": { "enum": ["9:16", "4:5", "1:1", "16:9"] },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "durationSec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number", "exclusiveMinimum": 0 },
            "max": { "type": "number", "exclusiveMinimum": 0 },
            "reference": { "description": "Length of the timeline that beat times are written on.", "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "onCamera": {
          "description": "How a person appears in the made cut. A face is never part of the default recipe.",
          "enum": ["none", "hands", "body-no-face"]
        },
        "speech": { "enum": ["none", "voiceover"] },
        "safeArea": {
          "description": "Margins kept clear of platform UI, as fractions of frame size.",
          "type": "object",
          "additionalProperties": false,
          "required": ["top", "bottom", "left", "right"],
          "properties": {
            "top": { "type": "number", "minimum": 0, "maximum": 0.5 },
            "bottom": { "type": "number", "minimum": 0, "maximum": 0.5 },
            "left": { "type": "number", "minimum": 0, "maximum": 0.5 },
            "right": { "type": "number", "minimum": 0, "maximum": 0.5 }
          }
        }
      }
    },
    "hook": {
      "description": "The hook's span is the beat whose role is hook.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "firstFrameHasText"],
      "properties": {
        "type": {
          "enum": [
            "question",
            "list-promise",
            "contradiction",
            "visual-shock",
            "text-promise",
            "pov",
            "countdown",
            "before-after",
            "other"
          ]
        },
        "firstFrameHasText": { "type": "boolean" }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "tIn", "tOut", "purpose", "swap"],
        "properties": {
          "id": { "$ref": "#/$defs/beatId" },
          "role": { "enum": ["hook", "setup", "item", "turn", "payoff", "cta", "loop", "pause"] },
          "tIn": { "type": "number", "minimum": 0 },
          "tOut": { "type": "number", "exclusiveMinimum": 0 },
          "purpose": { "description": "What the beat does for the viewer. No source wording.", "type": "string", "minLength": 1 },
          "swap": { "description": "What the maker puts here from their own content.", "type": "string", "minLength": 1 }
        }
      },
      "contains": { "type": "object", "properties": { "role": { "const": "hook" } }, "required": ["role"] },
      "minContains": 1,
      "maxContains": 1
    },
    "captions": {
      "description": "Caption layers. An empty array means the format has no captions.",
      "type": "array",
      "items": { "$ref": "#/$defs/captionLayer" }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moves", "zooms", "transitions"],
      "properties": {
        "moves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["beat", "move"],
            "properties": {
              "beat": { "$ref": "#/$defs/beatId" },
              "move": { "enum": ["static", "handheld", "push-in", "pull-out", "pan", "tilt", "orbit"] }
            }
          }
        },
        "zooms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "scaleFrom", "scaleTo", "durSec", "easing"],
            "properties": {
              "at": { "$ref": "#/$defs/at" },
              "scaleFrom": { "type": "number", "exclusiveMinimum": 0 },
              "scaleTo": { "type": "number", "exclusiveMinimum": 0 },
              "durSec": { "type": "number", "minimum": 0 },
              "easing": { "enum": ["linear", "ease-in", "ease-out", "ease-in-out", "snap"] }
            }
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "type"],
            "properties": {
              "at": { "$ref": "#/$defs/at" },
              "type": { "enum": ["hard-cut", "whip", "zoom-cut", "fade", "match-cut", "glitch"] }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bgm", "sfx", "voice", "referenceAudioUsed"],
      "properties": {
        "bgm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["present"],
          "properties": {
            "present": { "type": "boolean" },
            "character": { "description": "Mood and tempo in words. Never a track title.", "type": "string" },
            "entersAt": { "oneOf": [{ "$ref": "#/$defs/at" }, { "type": "null" }] },
            "duckUnderVoice": { "type": ["boolean", "null"] },
            "levelDbUnderVoice": { "description": "BGM RMS minus voice RMS in dB. null when not measured.", "type": ["number", "null"] }
          }
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["on", "type"],
            "properties": {
              "on": { "enum": ["card-in", "cut", "zoom", "payoff", "beat-drop", "other"] },
              "at": { "$ref": "#/$defs/at" },
              "type": { "type": "string", "minLength": 1 }
            }
          }
        },
        "voice": { "enum": ["none", "tts-voiceover", "own-voiceover"] },
        "referenceAudioUsed": { "const": false }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "default", "container", "needs", "paidApi", "talkingHead", "costUsdPerVideo", "status"],
        "properties": {
          "id": {
            "enum": ["code-motion", "caption-over-footage", "screen-recording", "image-gen-stills", "t2v", "i2v", "v2v", "r2v-talking"]
          },
          "default": { "type": "boolean" },
          "container": { "enum": ["ffmpeg-ass", "remotion", "hyperframes", "three-js", "html-canvas", "capcut", "other"] },
          "needs": {
            "oneOf": [
              { "type": "array", "items": { "const": "none" }, "minItems": 1, "maxItems": 1 },
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": ["image-gen", "t2v", "i2v", "v2v", "r2v", "lipsync", "tts", "screen-capture", "own-footage", "stock-footage"]
                }
              }
            ]
          },
          "paidApi": { "type": "boolean" },
          "talkingHead": { "type": "boolean" },
          "costUsdPerVideo": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max", "basis"],
            "properties": {
              "min": { "type": "number", "minimum": 0 },
              "max": { "type": "number", "minimum": 0 },
              "basis": { "type": "string", "minLength": 1 },
              "asOf": { "type": "string", "format": "date" }
            }
          },
          "status": { "enum": ["design-only", "written", "tested"] }
        },
        "allOf": [
          {
            "if": { "properties": { "id": { "const": "r2v-talking" } } },
            "then": { "properties": { "talkingHead": { "const": true } } }
          },
          {
            "if": { "properties": { "needs": { "contains": { "enum": ["r2v", "lipsync"] } } } },
            "then": { "properties": { "talkingHead": { "const": true } } }
          },
          {
            "if": { "properties": { "talkingHead": { "const": true } } },
            "then": { "properties": { "default": { "const": false } } }
          },
          {
            "if": { "properties": { "needs": { "contains": { "enum": ["image-gen", "t2v", "i2v", "v2v", "r2v", "lipsync"] } } } },
            "then": { "properties": { "paidApi": { "const": true } }, "required": ["costUsdPerVideo"] }
          },
          {
            "if": { "properties": { "paidApi": { "const": false } } },
            "then": { "properties": { "costUsdPerVideo": { "properties": { "min": { "const": 0 }, "max": { "const": 0 } } } } }
          },
          {
            "if": { "properties": { "paidApi": { "const": true } } },
            "then": { "properties": { "costUsdPerVideo": { "required": ["asOf"] } } }
          }
        ]
      },
      "contains": { "type": "object", "properties": { "default": { "const": true } }, "required": ["default"] },
      "minContains": 1,
      "maxContains": 1
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "license", "source"],
        "properties": {
          "family": { "type": "string", "minLength": 1 },
          "license": { "description": "SPDX id when one exists, such as OFL-1.1.", "type": "string", "minLength": 1 },
          "source": { "type": "string", "format": "uri" }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["makerSupplies", "neverUse"],
      "properties": {
        "makerSupplies": {
          "description": "Assets the maker must hold rights to before making a cut.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "neverUse": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "evidence": {
      "description": "Dotted paths into this frontmatter, grouped by how the value was obtained.",
      "type": "object",
      "additionalProperties": false,
      "required": ["measured", "inferred", "unmeasured"],
      "properties": {
        "measured": { "type": "array", "items": { "type": "string" } },
        "inferred": { "type": "array", "items": { "type": "string" } },
        "unmeasured": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["measured", "produced"] } } },
      "then": { "properties": { "evidence": { "properties": { "measured": { "minItems": 1 } } } } }
    },
    {
      "if": { "properties": { "captions": { "minItems": 1 } } },
      "then": { "properties": { "fonts": { "minItems": 1 } } }
    }
  ]
}
